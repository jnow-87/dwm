mainmenu "dwm configuration"

config FONT
	qstring "font"
	default "monospace:size=10"

config BORDER_PIXEL
	int "number of border pixels"
	default 1

config SNAP_PIXEL
	int "number of pixels to trigger window snapping"
	default 32

config XINERAMA
	bool "xinerama"

menu "statusbar"
	config STATUSBAR_HEIGHT
		int "statusbar height"
		default 20

	config STATUSBAR_PADDING
		int "padding between statusbar elements"
		default 2

	config STATUSBAR_SPACER_LEFT
		qstring "statusbar spacer (left)"
		default ""

	config STATUSBAR_SPACER_INTRA_LEFT
		qstring "statusbar spacer within a statusbar section (left)"
		default ""

	config STATUSBAR_SPACER_RIGHT
		qstring "statusbar spacer (right)"
		default ""

	config STATUSBAR_TAGS_MULTI
		qstring "tag string if multiple tags are selected"
		default "⇆"

	config STATUSBAR_LAUNCHER_ICON
		qstring "statusbar launcher icon"
		default ""

	config STATUSBAR_KEYLOCK_ICON
		qstring "statusbar keylock icon"
		default "󱌠"

	config STATUSBAR_ZAPHOD_ICON
		qstring "statusbar zaphod head icon"
		default "󰀎"
endmenu

config WIN_RESIZE_PIXEL
	int "number of pixels by which to resize clients"

config WIN_MOVE_PIXEL
	int "number of pixels by which to move clients"

config FADE_STEPS
	int "number of animation steps for fading windows"
	default 5

config FADE_DELAY_MS
	int "delay per fading window animation step [ms]"
	default 25

menu "layouts"
	source "layouts/Pconfig"
endmenu

config LOG_FILE
	qstring "log file"
	default "~/dwm.log"

# build config
choice
	prompt "Build type"

	config BUILD_RELEASE
		bool "release"

	config BUILD_DEBUG
		bool "debug"
endchoice

config BUILD_TREE
	string "build tree"
	default "build/$(CONFIG_BUILD_TYPE)"

menu "Hidden"
	visible if 0

	config BUILD_TYPE
		string "Build type"
		default "debug" if BUILD_DEBUG
		default "release" if BUILD_RELEASE
endmenu
